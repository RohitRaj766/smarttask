{
  "expo": {
    "name": "SmartTask",
    "slug": "smarttask-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smarttask",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smarttask.mobile"
    },
    "android": {
      "package": "com.smarttask.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a73ce81b-5b6f-45ff-8a50-12706e822150"
      }
    },
    "owner": "rohitraj2k04"
  }
}
